name: CI

# NOTE: rendered by `devx scaffold` (Go text/template). GitHub Actions
# expressions are escaped so the template engine emits them literally instead
# of trying to evaluate them as template actions (do not "simplify" the escapes).

on:
  push:
    branches: [main]
    # tags MUST be nested under push: (a top-level on.tags key is ignored by
    # GitHub, which previously meant the release job never fired on a tag).
    tags: ["v*"]
  pull_request:
    branches: [main]

# Least-privilege default token; the release job elevates to contents: write.
permissions:
  contents: read

# Cancel a superseded PR's run; never cancel push-to-main or tag (release) runs.
concurrency:
  group: ${{"{{"}} github.workflow }}-${{"{{"}} github.ref }}
  cancel-in-progress: ${{"{{"}} github.event_name == 'pull_request' }}

jobs:
  test:
    name: Test & Lint
    runs-on: ubuntu-latest
    timeout-minutes: 15
    steps:
      - uses: actions/checkout@v6
      - uses: actions/setup-go@v6
        with:
          go-version: "{{.GoVersion}}"
          cache: true
      - run: go test ./...
      - uses: golangci/golangci-lint-action@v9
        with:
          # Pin the linter: `version: latest` silently breaks green builds when a
          # new golangci-lint release changes its rules or config schema.
          version: v2.12.1

  release:
    name: GoReleaser
    runs-on: ubuntu-latest
    needs: test
    if: startsWith(github.ref, 'refs/tags/')
    timeout-minutes: 30
    permissions:
      contents: write
    steps:
      - uses: actions/checkout@v6
        with:
          fetch-depth: 0
      - uses: actions/setup-go@v6
        with:
          go-version: "{{.GoVersion}}"
          cache: true
      - uses: goreleaser/goreleaser-action@v6
        with:
          version: "~> v2"
          args: release --clean
        env:
          GITHUB_TOKEN: ${{"{{"}} secrets.GITHUB_TOKEN }}
