name: CI

# NOTE: rendered by `devx scaffold` (Go text/template). GitHub Actions
# expressions are escaped so the template engine emits them literally instead
# of trying to evaluate them as template actions (do not "simplify" the escapes).

on:
  push:
    branches: [main]
  pull_request:
    branches: [main]

# Least-privilege default token.
permissions:
  contents: read

# Cancel a superseded PR's run; never cancel push-to-main runs.
concurrency:
  group: ${{"{{"}} github.workflow }}-${{"{{"}} github.ref }}
  cancel-in-progress: ${{"{{"}} github.event_name == 'pull_request' }}

jobs:
  test:
    name: Test
    runs-on: ubuntu-latest
    timeout-minutes: 15
    services:
      postgres:
        image: postgres:16-alpine
        env:
          POSTGRES_USER: dev
          POSTGRES_PASSWORD: dev
          POSTGRES_DB: {{.ProjectSlug}}_test
        ports: ["5432:5432"]
        options: >-
          --health-cmd pg_isready
          --health-interval 10s
          --health-timeout 5s
          --health-retries 5
    env:
      DATABASE_URL: postgres://dev:dev@localhost:5432/{{.ProjectSlug}}_test?sslmode=disable
    steps:
      - uses: actions/checkout@v6
      - uses: actions/setup-go@v6
        with:
          go-version: "{{.GoVersion}}"
          cache: true
      - name: Run migrations
        run: psql "$DATABASE_URL" -f db/migrations/001_initial.sql
      - name: Run seeds
        run: psql "$DATABASE_URL" -f db/seeds/001_sample_data.sql
      - name: Test
        run: go test -race -coverprofile=coverage.out ./...
      - name: Lint
        uses: golangci/golangci-lint-action@v9
        with:
          version: v2.12.1

  build:
    name: Build
    runs-on: ubuntu-latest
    needs: test
    timeout-minutes: 15
    steps:
      - uses: actions/checkout@v6
      - uses: actions/setup-go@v6
        with:
          go-version: "{{.GoVersion}}"
          cache: true
      - name: Build
        run: CGO_ENABLED=0 go build -ldflags="-s -w" -o /dev/null .
