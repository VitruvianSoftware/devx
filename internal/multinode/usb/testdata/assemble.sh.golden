#!/usr/bin/env bash
# devx usb assembly — GENERATED.
set -euxo pipefail

IMG="/tmp/devx/devx-usb.img"
WORK=$(dirname "$IMG")
mkdir -p "$WORK"

butane --strict -o "$WORK/devx-node.ign" "/tmp/devx/payload/fcos/ephemeral/devx-join.bu"

rm -f "$IMG"
truncate -s 4096M "$IMG"
LOOP=$(losetup --show -f -P "$IMG")
trap '[ -n "${LOOP:-}" ] && losetup -d "$LOOP" 2>/dev/null || true' EXIT

podman run --rm --privileged --net=host --security-opt label=disable \
  -v /dev:/dev -v /run/udev:/run/udev -v "$WORK":/data \
  quay.io/coreos/coreos-installer:release \
  install "$LOOP" --ignition-file /data/devx-node.ign

losetup -d "$LOOP"
LOOP=""
rm -f "$WORK/devx-node.ign"
sync
echo "devx: image ready at $IMG"
