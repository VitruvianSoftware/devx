# ──────────────────────────────────────────────────────────────────────────────
# devx cluster — multi-node K3s cluster topology.
#
# Quick start:
#   1. cp cluster.yaml.example cluster.yaml
#   2. Edit cluster.yaml: pick a cluster name, list your Macs as nodes,
#      and paste a fresh Tailscale auth key (see comment below).
#   3. devx cluster init       (bootstrap from scratch)
#      devx cluster apply      (reconcile after edits)
#      devx cluster status     (current state)
#      devx cluster doctor     (pre-flight health checks)
#
# Why this file is .example: the real cluster.yaml contains a Tailscale
# auth key, which is sensitive. cluster.yaml itself is .gitignored so the
# key never lands in git history. Copy this template, fill in your own
# values, and never commit your filled-in cluster.yaml.
# ──────────────────────────────────────────────────────────────────────────────

cluster:
  # Unique name for this cluster; surfaces in `devx cluster status` and
  # is used as a label on the generated kubeconfig context.
  name: my-cluster

  # Pin a K3s version for deterministic provisioning. Bump it via
  # `devx cluster upgrade` (rolling, zero-downtime) rather than hand-editing.
  k3sVersion: "v1.35.3+k3s1"

  # Where to write the kubeconfig that `kubectl` should use against this
  # cluster. Keep it separate from your default ~/.kube/config so you
  # don't clobber other contexts.
  kubeconfig: "~/.kube/cluster.yaml"
  # Optional: Enable Docker container runtime and forward docker.sock to host
  docker:
    enabled: true

  # Host directories shared into every VM. Containers launched by the in-VM
  # Docker daemon (e.g. devcontainers) see these at the same path, so bind
  # mounts of host paths resolve correctly.
  #
  # If this key is OMITTED, devx defaults to mounting the host home dir:
  #     mounts:
  #       - location: "~"
  #         writable: true
  # Set `mounts: []` to opt out entirely.
  mounts:
    - location: "~"        # host path; "~" expands on the target host and
                           # mounts at the same path inside the guest
      writable: true
    # - location: "/data"
    #   mountPoint: "/mnt/data"  # optional; defaults to the same path as location
    #   writable: false


  # Backend-neutral LoadBalancer settings, shared by BOTH the MetalLB path and
  # Cilium LB-IPAM. The ipRange must be reachable on the LAN your nodes share —
  # pick a block outside your DHCP server's allocation pool. l2Hostnames (optional)
  # pins L2/ARP advertisement to stable nodes and is also the set of nodes that
  # advertise the LB /24 over tailscale. Prefer this over the legacy metallb.ipRange
  # / metallb.l2Hostnames below (which are still honoured as a fallback).
  loadBalancer:
    ipRange: 192.168.1.240-192.168.1.250
    # l2Hostnames:
    #   - node-a
    #   - node-b

  # MetalLB provides LoadBalancer services on bare-metal/Lima setups. Set
  # enabled: true to install it (it reads loadBalancer.ipRange above; legacy
  # metallb.ipRange/l2Hostnames still work as a fallback). Mutually exclusive with
  # Cilium LB-IPAM — see cilium below.
  metallb:
    enabled: true

  # Cilium CNI. When enabled, k3s ships with Flannel, kube-proxy, the network
  # policy controller, and servicelb all disabled — Cilium replaces them and
  # provides LoadBalancer IPs via LB-IPAM (CiliumLoadBalancerIPPool +
  # CiliumL2AnnouncementPolicy, configured in GitOps, not here). Mutually exclusive
  # with MetalLB: with cilium.enabled the MetalLB phase is skipped, but
  # loadBalancer.ipRange/l2Hostnames are still used to advertise the LB /24 over
  # tailscale. The version below is informational; the Helm chart pin lives in GitOps.
  cilium:
    enabled: false
    version: "1.17.17"

  # Tailscale joins every node to your tailnet so the cluster works
  # across NATs and from anywhere. The auth key below is REQUIRED —
  # generate a fresh one at:
  #   https://login.tailscale.com/admin/settings/keys
  # Recommended key settings: Reusable, Ephemeral OFF, Pre-approved,
  # Tag-limited (e.g. tag:devx-cluster), 90-day expiry.
  tailscale:
    enabled: true
    authKey: "tskey-auth-REPLACE_ME_WITH_A_FRESH_KEY"

# ──────────────────────────────────────────────────────────────────────────────
# Nodes — one entry per machine that joins the cluster.
#
# roles:
#   server  → control-plane (etcd + API server). Use an odd count (1, 3, 5).
#   agent   → worker node, runs your application pods.
#
# kind:
#   lima    → (DEFAULT) a macOS host where devx provisions a Lima VM. The `vm:`
#             block (cpus/memory/disk) is REQUIRED.
#   native  → a Linux host that runs K3s directly (bare-metal: NUCs, servers,
#             a Linux desktop). NO `vm:` block — devx skips VM sizing entirely.
#             Optionally pin its tailnet IP with `nodeIP:` and override SSH
#             access with `sshUser:` / `sshPort:` / `sshKeyPath:`.
#   NOTE: kind defaults to `lima`, so a bare-metal Linux node WITHOUT
#   `kind: native` fails validation demanding vm.cpus/memory/disk.
#
# pool: an opaque tag for grouping nodes in `devx cluster status` output;
#       must be UNIQUE per node.
# vm:   per-node Lima VM resources (kind=lima only). Start small; bump for
#       heavier workloads.
# ──────────────────────────────────────────────────────────────────────────────

nodes:
  - host: my-laptop
    role: server
    pool: laptop-cp-1
    vm:
      cpus: 2
      memory: 4GiB
      disk: 30GiB

  - host: my-desktop
    role: server
    pool: desktop-cp-1
    vm:
      cpus: 8
      memory: 10GiB
      disk: 80GiB

  - host: my-build-machine
    role: agent
    pool: workers
    vm:
      cpus: 8
      memory: 20GiB
      disk: 100GiB

  # A bare-metal Linux host (e.g. a NUC or a Linux server). K3s runs directly on
  # the host — no Lima VM — so there is NO `vm:` block. Without `kind: native`
  # devx would default to `lima` and reject this node for missing vm sizing.
  - host: my-nuc
    role: agent
    pool: nuc-workers
    kind: native
    # nodeIP: 100.x.y.z        # optional: pin the tailscale IP if auto-detect is wrong
    # sshUser: james           # optional: SSH user devx uses to provision the host
    # sshPort: "22"            # optional
    # sshKeyPath: ~/.ssh/id_ed25519  # optional
